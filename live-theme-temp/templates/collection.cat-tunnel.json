          }
        },
        "text_faMV36": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Promotes healthy exercise</strong> – especially important for indoor cats.<br/><strong>Encourages independence</strong> – cats can entertain themselves when you’re busy.<br/><strong>Reduces stress</strong> – a dedicated hideout lowers anxiety in multi-pet homes.<br/><strong>Strengthens bonding</strong> – interactive games like wand-toy chase through the tunnel build trust.<br/><strong>Protects your furniture</strong> – a tunnel redirects energy away from destructive scratching.</p>"
          }
        }
