<div class="melcat-pack-preview" style="padding: 2rem; background: {{ block.settings.bg_color }}; border-radius: 12px; margin: 2rem 0;">
  <div style="text-align: center; margin-bottom: 2rem;">
    <h2 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: {{ block.settings.text_color }};">{{ block.settings.title }}</h2>
    <p style="margin: 0.5rem 0 0; color: {{ block.settings.text_color }}; opacity: 0.8;">{{ block.settings.subtitle }}</p>
  </div>
  
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1rem;">
    {% if block.settings.img_1 != blank %}
      <div style="border-radius: 8px; overflow: hidden; border: 2px solid rgba(0,0,0,0.1);">
        <img src="{{ block.settings.img_1 | image_url: width: 400 }}" width="400" height="400" style="width: 100%; height: auto; display: block;" loading="lazy">
      </div>
    {% endif %}
    {% if block.settings.img_2 != blank %}
      <div style="border-radius: 8px; overflow: hidden; border: 2px solid rgba(0,0,0,0.1);">
        <img src="{{ block.settings.img_2 | image_url: width: 400 }}" width="400" height="400" style="width: 100%; height: auto; display: block;" loading="lazy">
      </div>
    {% endif %}
    {% if block.settings.img_3 != blank %}
      <div style="border-radius: 8px; overflow: hidden; border: 2px solid rgba(0,0,0,0.1);">
        <img src="{{ block.settings.img_3 | image_url: width: 400 }}" width="400" height="400" style="width: 100%; height: auto; display: block;" loading="lazy">
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Pack Preview",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What's inside the Digital Pack?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Reaction GIFs, stickers, and exclusive printable art."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2d1b0d"
    },
    {
      "type": "image_picker",
      "id": "img_1",
      "label": "Preview Image 1"
    },
    {
      "type": "image_picker",
      "id": "img_2",
      "label": "Preview Image 2"
    },
    {
      "type": "image_picker",
      "id": "img_3",
      "label": "Preview Image 3"
    }
  ]
}
{% endschema %}
