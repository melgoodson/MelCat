    "rich_text_nLTi66": {
      "type": "rich-text",
      "blocks": {
        "heading_W6cEpH": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Real-Life Examples from My Experience</strong>",
            "heading_size": "h2"
          }
        },
        "text_YzAKaa": {
          "type": "text",
          "settings": {
            "text": "<ul><li><strong>The Playful Kitten:</strong> Loved darting through a pop up tube to chase feather toys. It doubled as her favorite nap spot once she tired out.<br/><br/></li><li><strong>The Senior Cat:</strong> Preferred a tent-style hideout lined with a soft blanket. It became her safe place when grandchildren visited.<br/><br/></li><li><strong>The Two-Cat Household:</strong> With one tent and one tube, both cats had “territories,” cutting down on scuffles and stress.<br/><br/></li><li><strong>The Travel Cat:</strong> A nervous tabby calmed down during hotel stays because his familiar tube came along for the trip.<br/><br/></li></ul><p>The versatility of these products makes them suitable for almost any type of cat.</p>"
          }
        }
      },
      "block_order": [
        "heading_W6cEpH",
