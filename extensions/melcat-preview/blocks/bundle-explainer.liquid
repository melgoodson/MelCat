<div class="melcat-bundle-explainer" style="background: #fafafa; border: 1px dashed #ccc; padding: 2rem; border-radius: 12px; margin: 2rem 0; text-align: center;">
  <h2 style="margin: 0 0 1.5rem; font-size: 1.25rem;">How to claim your digital items</h2>
  <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem;">
    <div style="flex: 1 1 150px;">
      <div style="font-size: 2rem; margin-bottom: 0.5rem;">📦</div>
      <p style="margin:0; font-weight: bold;">1. Receive</p>
      <p style="margin:0; font-size: 0.85rem; color: #666;">Get your physical order in the mail</p>
    </div>
    <div style="flex: 1 1 150px;">
      <div style="font-size: 2rem; margin-bottom: 0.5rem;">📱</div>
      <p style="margin:0; font-weight: bold;">2. Scan</p>
      <p style="margin:0; font-size: 0.85rem; color: #666;">Scan the secret QR code on the insert card</p>
    </div>
    <div style="flex: 1 1 150px;">
      <div style="font-size: 2rem; margin-bottom: 0.5rem;">✨</div>
      <p style="margin:0; font-weight: bold;">3. Unlock</p>
      <p style="margin:0; font-size: 0.85rem; color: #666;">Instantly access your digital library!</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bundle Explainer",
  "target": "section",
  "settings": []
}
{% endschema %}
