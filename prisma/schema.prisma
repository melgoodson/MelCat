generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// SHOPIFY / ADMIN
// ---------------------------------------------------------

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WebhookEvent {
  id          String   @id // Webhook ID from Shopify payload
  topic       String
  processedAt DateTime @default(now())
  status      String   @default("success") // success, failed, skipped
}

model AdminAuditLog {
  id         String      @id @default(cuid())
  action     String      // e.g. "MANUAL_GRANT"
  adminUser  String?     // Admin user context if available
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  details    String?     // JSON as string: { oldEmail: '...', newEmail: '...' }
  createdAt  DateTime    @default(now())
}

// ---------------------------------------------------------
// CUSTOMER IDENTITY & AUTH
// ---------------------------------------------------------

model Customer {
  id                String             @id @default(cuid())
  email             String             @unique
  shopifyCustomerId String?
  loginTokens       EmailLoginToken[]
  sessions          CustomerSession[]
  entitlements      Entitlement[]
  redemptions       QRRedemption[]
  auditLogs         AdminAuditLog[]
  dropNotifications DropNotificationLog[]
  events            CustomerEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model EmailLoginToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  tokenHash  String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CustomerSession {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  sessionToken String   @unique // HttpOnly cookie value
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------
// CONTENT SYSTEM
// ---------------------------------------------------------

model Tier {
  id        String   @id @default(cuid())
  name      String   @unique // Lite, Standard, Deluxe, Ultimate
  level     Int      @unique // 1, 2, 3, 4
  packs     Pack[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pack {
  id           String                  @id @default(cuid())
  name         String
  tierId       String
  tier         Tier                    @relation(fields: [tierId], references: [id])
  isActive     Boolean                 @default(true) // Soft delete
  packAssets   PackAsset[]
  entitlements Entitlement[]
  qrCampaigns  QRCampaign[]
  mappings     ProductVariantPackMap[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model DigitalAsset {
  id           String       @id @default(cuid())
  title        String
  type         String       // e.g. "GIF", "MP4", "PDF"
  fileKey      String       // R2 Object Key
  thumbnailUrl String?
  isActive     Boolean      @default(true) // Soft delete
  packAssets   PackAsset[]
  dropAssets   DropAsset[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model PackAsset {
  packId       String
  pack         Pack         @relation(fields: [packId], references: [id])
  assetId      String
  digitalAsset DigitalAsset @relation(fields: [assetId], references: [id])
  
  @@id([packId, assetId])
}

model Drop {
  id                String      @id @default(cuid())
  title             String
  releaseDate       DateTime
  requiredTierLevel Int         // Dynamic rule: max(Entitlements.Tier.level) >= Drop.requiredTierLevel
  isActive          Boolean     @default(true)
  dropAssets        DropAsset[]
  notifications     DropNotificationLog[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model DropAsset {
  dropId       String
  drop         Drop         @relation(fields: [dropId], references: [id])
  assetId      String
  digitalAsset DigitalAsset @relation(fields: [assetId], references: [id])
  
  @@id([dropId, assetId])
}

model DropNotificationLog {
  id           String   @id @default(cuid())
  dropId       String
  drop         Drop     @relation(fields: [dropId], references: [id])
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  sentAt       DateTime @default(now())
  status       String   @default("sent") // sent, failed
  errorMessage String?

  @@unique([dropId, customerId])
}

model CustomerEvent {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  eventType  String    // e.g. "claim_completed", "asset_downloaded"
  metadata   Json?     // { packId, assetId, dropId, campaignId, targetVariantId }
  sessionId  String?
  source     String?   // "library", "qr", "email", "webhook"
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([eventType])
  @@index([createdAt])
}

// ---------------------------------------------------------
// TRANSACTIONS & ACCESS
// ---------------------------------------------------------

model Entitlement {
  id         String            @id @default(cuid())
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  packId     String
  pack       Pack              @relation(fields: [packId], references: [id])
  source     String            // e.g. PURCHASE, QR_CLAIM
  revoked    Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([customerId])
  @@index([packId])
}

model ProductVariantPackMap {
  id        String   @id @default(cuid())
  variantId String   @unique // 1 Shopify variant maps to 1 App pack
  productId String
  packId    String
  pack      Pack     @relation(fields: [packId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([variantId])
}

model QRCampaign {
  id             String         @id @default(cuid())
  campaignHash   String         @unique
  packId         String
  pack           Pack           @relation(fields: [packId], references: [id])
  isActive       Boolean        @default(true)
  maxRedemptions Int?
  redemptions    QRRedemption[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model QRRedemption {
  id         String     @id @default(cuid())
  campaignId String
  campaign   QRCampaign @relation(fields: [campaignId], references: [id])
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  ipAddress  String?
  claimedAt  DateTime   @default(now())

  // Fraud prevention: One claim per customer per campaign
  @@unique([campaignId, customerId]) 
}

// ---------------------------------------------------------
// AMAZON SYSTEM
// ---------------------------------------------------------

model AmazonOrder {
  orderId      String    @id // Amazon Order ID (e.g. "123-4567890-1234567")
  sku          String?   // Product SKU purchased
  email        String?   // Customer email if imported
  isClaimed    Boolean   @default(false)
  claimedAt    DateTime?
  claimedBy    String?   // Customer email who claimed it
  createdAt    DateTime  @default(now())
}

model AmazonClaim {
  id           String    @id @default(cuid())
  orderId      String    // Amazon Order ID (e.g. "123-4567890-1234567")
  email        String    // Customer email claiming
  campaignHash String?   // Linked QR campaign if scanned
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  claimedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orderId, email])
}

// ---------------------------------------------------------
// LEGACY SUPABASE TABLES (to prevent dropping)
// ---------------------------------------------------------

model big_mel_entitlements {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String?
  customer_email String?
  shop_domain    String
  variant_id     String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

model big_mel_chat_usage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id  String
  shop_domain String
  chat_count  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([session_id, shop_domain], map: "unique_session_shop")
}

model big_mel_webhook_events {
  id          String   @id
  topic       String
  shop_domain String
  payload     Json
  processed   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}


