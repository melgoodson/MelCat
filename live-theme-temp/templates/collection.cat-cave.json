    "rich_text_8atpqp": {
      "type": "rich-text",
      "blocks": {
        "heading_7jTBtL": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Unique Features of the Snarky Pets Cat Cave</strong>",
            "heading_size": "h2"
          }
        },
        "text_cE7LyU": {
          "type": "text",
          "settings": {
            "text": "<p>Here’s what sets this product apart from standard cat beds:</p><ul><li><strong>Circular Entrance with Side Vents</strong> – Cats love to peek out while feeling secure. The vents allow airflow so the inside never feels stuffy.<br/><br/></li><li><strong>Spacious Design</strong> – Sized for cats up to 12 lbs, with enough room to curl, stretch, or nap in multiple positions.<br/><br/></li><li><strong>Sturdy Yet Portable</strong> – Lightweight enough to move from room to room, but solid enough to keep its shape.<br/><br/></li><li><strong>Easy Cleaning</strong> – Vacuum out fur or wipe down with a damp cloth. Unlike fabric beds, you won’t be constantly washing covers.<br/><br/></li></ul><p>One of my clients, who has a curious tabby, uses the cave in her office. She says her cat spends hours watching her work from inside, safe but still close by.</p>"
          }
        }
      },
      "block_order": [
        "heading_7jTBtL",
        "text_cE7LyU"
      ],
      "name": "t:sections.rich-text.presets.name",
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
