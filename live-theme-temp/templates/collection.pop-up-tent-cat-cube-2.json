    "rich_text_PVmERH": {
      "type": "rich-text",
      "blocks": {
        "heading_hDNwXi": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Care & Maintenance</strong>",
            "heading_size": "h2"
          }
        },
        "text_Yy87Jm": {
          "type": "text",
          "settings": {
            "text": "<p>Vacuum interior and mesh walls regularly to reduce fur build-up.<br/>Spot clean with mild soap; keep mesh dry to avoid mildew.<br/>Periodically check seams & zippers, especially the ones used to connect to tunnels.<br/>Fold and store when not in use for long periods, especially in climates with humidity.</p>"
          }
        }
      },
      "block_order": [
        "heading_hDNwXi",
