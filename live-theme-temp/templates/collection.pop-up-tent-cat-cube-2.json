    "rich_text_QNTdcA": {
      "type": "rich-text",
      "blocks": {
        "heading_Q7drgC": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Placement Tips & Usage Examples</strong>",
            "heading_size": "h2"
          }
        },
        "text_Ff8GJk": {
          "type": "text",
          "settings": {
            "text": "<p>Put the cube near quiet but familiar areas—by windows, near beds, or beside favorite lounging chairs.<br/>If connecting to the cat tunnel, create an “adventure zone” that leads from cube → tunnel → cube for maximal fun.<br/><br/>Rotate cubes between rooms to keep novelty alive.<br/>Use inside during visitors or when noises are loud—cats love retreats to escape noise.<br/>For everyday engagement, toss a toy or small ball in the cube; they’ll surprise themselves.</p>"
          }
        }
      },
      "block_order": [
