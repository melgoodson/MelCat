      "blocks": {
        "heading_xVMrXT": {
          "type": "heading",
          "settings": {
            "heading": "<strong>FAQs</strong>",
            "heading_size": "h2"
          }
        },
        "text_G6zn6q": {
          "type": "text",
          "settings": {
            "text": "<p><strong>1. How often should I replace the scratch insert?<br/></strong> Every 3–6 months for average use; sooner if your cat is heavy on the paws or uses it nightly.</p><p><strong>2. Do cats scratch cardboard as well as sisal?<br/></strong> Yes—cardboard is softer, offers satisfying texture, and is especially appealing when paired with activity or hiding cues.</p><p><strong>3. How many scratch boxes should a multi-cat home have?</strong> Provide at least one box per cat, ideally plus one extra to reduce competition and provide variety.<br/><br/></p>"
          }
        }
